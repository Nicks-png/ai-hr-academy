# ── IA Provider (use apenas um) ──────────────────────────────────────────────
# Google Gemini — gratuito, sem cartão: aistudio.google.com
GEMINI_API_KEY=

# Groq — gratuito, muito rápido: console.groq.com
GROQ_API_KEY=

# OpenRouter — pago: openrouter.ai
OPENROUTER_API_KEY=

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# Sua URL da Evolution API (Docker local ou hosted)
EVOLUTION_API_URL=http://localhost:8080

# API Key configurada na Evolution API
EVOLUTION_API_KEY=

# Nome da instância criada na Evolution API
EVOLUTION_INSTANCE=accor-recruiter

# ── Microsoft Outlook / Azure (opcional — integração de agenda) ──────────────
# Crie o app em portal.azure.com > Azure Active Directory > App registrations
# Adicione "triagem.html" como Redirect URI do tipo "Single-page application"
# Permissões necessárias: Calendars.ReadWrite, User.Read (delegadas)
AZURE_CLIENT_ID=

# ── Autenticação JWT (Intranet) ───────────────────────────────────────────────
JWT_SECRET=accor-secret-2025

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
